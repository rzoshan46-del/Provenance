# ==============================================================================
# CritX Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Settings
# ------------------------------------------------------------------------------
# Application environment ('development' or 'production').
# In production, secure cookies and strict validation are enforced.
APP_ENV=development

# Base URL for OAuth callback generation and absolute links.
# Required in production (e.g., https://your-domain.railway.app).
APP_BASE_URL=http://localhost:8000

# Session encryption secret key.
# REQUIRED IN PRODUCTION: Must be set to a strong random secret.
SESSION_SECRET=provenance-demo-secret-key-change-in-production

# CORS allowed origins (comma-separated or '*' in dev).
FRONTEND_ORIGIN=http://localhost:8000,http://localhost:3000

# Whether to enable OpenAPI /docs and /redoc ('1' or '0'). Disabled in production by default.
DOCS_ENABLED=1

# ------------------------------------------------------------------------------
# Authentication (Google OAuth)
# ------------------------------------------------------------------------------
# Authentication mode: 'demo' (persona picker) or 'google' (Google OAuth).
AUTH_MODE=demo

# Google OAuth 2.0 Client ID (Required in production if AUTH_MODE=google).
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth 2.0 Client Secret (Required in production if AUTH_MODE=google).
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# Database Settings
# ------------------------------------------------------------------------------
# Path to SQLite database file or PostgreSQL connection URL.
PROVENANCE_DB=data/app.db

# Optional Postgres connection string (e.g., postgresql://user:pass@host:5432/dbname).
DATABASE_URL=

# ------------------------------------------------------------------------------
# Neo4j Graph Database (Optional)
# ------------------------------------------------------------------------------
# Neo4j Bolt connection URI (e.g., neo4j+s://your-instance.databases.neo4j.io).
NEO4J_URI=

# Neo4j database username.
NEO4J_USER=neo4j

# Neo4j database password.
NEO4J_PASSWORD=

# ------------------------------------------------------------------------------
# AI & LLM Gateway
# ------------------------------------------------------------------------------
# AI model route ('off', 'canned', 'ollama', 'gemini').
PROVENANCE_LLM=canned

# Gemini API Key (if PROVENANCE_LLM=gemini).
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Demo & Governance Mode
# ------------------------------------------------------------------------------
# Enable demo features, story walkthrough, and persona switcher ('1' or '0').
PROVENANCE_DEMO=1

# Enforce mandatory manual peer review before milestone submission.
REQUIRE_PROJECT_REVIEW=0
