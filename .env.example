# Production app settings
APP_ENV=production
AUTH_MODE=google
PROVENANCE_DEMO=0
PROVENANCE_LLM=off
PROVENANCE_DB=data/app.db

# Google OAuth (required for real sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional deployment settings
APP_BASE_URL=http://127.0.0.1:8000
SESSION_SECRET=change-me-in-production

# Optional Postgres connection for production DB migration
# PROVENANCE_DATABASE_URL=postgresql://user:password@host:5432/provenance
